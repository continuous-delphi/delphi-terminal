package Delphi.Terminal.Plugin;

{$R *.res}
{$R 'Delphi.Terminal.Version.res'}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS OFF}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO OFF}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE RELEASE}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'Continuous-Delphi: delphi-terminal. A dockable terminal window for RAD Studio (Launch via: View > delphi-terminal)'}
{$LIBSUFFIX AUTO}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

requires
  rtl,
  vcl,
  designide;

contains
  Delphi.Terminal.Plugin.Registration in 'Delphi.Terminal.Plugin.Registration.pas',
  Delphi.Terminal.Plugin.DockForm in 'Delphi.Terminal.Plugin.DockForm.pas',
  Delphi.Terminal.Plugin.Wizard in 'Delphi.Terminal.Plugin.Wizard.pas',
  Delphi.Terminal.Plugin.Menu in 'Delphi.Terminal.Plugin.Menu.pas',
  Delphi.Terminal.Plugin.Lifecycle in 'Delphi.Terminal.Plugin.Lifecycle.pas',
  Delphi.Terminal.Plugin.OptionsPage in 'Delphi.Terminal.Plugin.OptionsPage.pas',
  Delphi.Terminal.Plugin.KeyBinding in 'Delphi.Terminal.Plugin.KeyBinding.pas',
  Delphi.Terminal.Plugin.OptionsFrame in 'Delphi.Terminal.Plugin.OptionsFrame.pas' {frameDelphiTerminalOptions},
  Delphi.Terminal.CommandHistory in '..\..\source\Delphi.Terminal.CommandHistory.pas',
  Delphi.Terminal.Frame.CmdShell in '..\..\source\Delphi.Terminal.Frame.CmdShell.pas',
  Delphi.Terminal.Settings in '..\..\source\Delphi.Terminal.Settings.pas',
  Delphi.Terminal.AnsiParser in '..\..\source\Delphi.Terminal.AnsiParser.pas',
  Delphi.Terminal.CmdShell in '..\..\source\Delphi.Terminal.CmdShell.pas';

end.
