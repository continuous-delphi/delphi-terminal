package Delphi.Terminal.Plugin;

{$INCLUDE ..\..\source\DELPHI_COMPILER_VERSIONS.inc}


{$R *.res}
{$R 'Delphi.Terminal.Version.res'}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS OFF}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO OFF}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE RELEASE}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'Continuous-Delphi: delphi-terminal. A dockable terminal window for RAD Studio (Launch via: View > delphi-terminal)'}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

{$IFDEF CD_DELPHI_10_4_OR_LATER}  
{$LIBSUFFIX AUTO}  //When you use this flag, the compiler automatically appends its version number to the resulting package (BPL) files
{$ENDIF}

requires
  rtl,
  vcl,
  designide;

contains
  Delphi.Terminal.Plugin.Registration in 'Delphi.Terminal.Plugin.Registration.pas',
  Delphi.Terminal.Plugin.DockForm in 'Delphi.Terminal.Plugin.DockForm.pas',
  Delphi.Terminal.Plugin.Wizard in 'Delphi.Terminal.Plugin.Wizard.pas',
  Delphi.Terminal.Plugin.Menu in 'Delphi.Terminal.Plugin.Menu.pas',
  Delphi.Terminal.Plugin.Lifecycle in 'Delphi.Terminal.Plugin.Lifecycle.pas',
  Delphi.Terminal.Plugin.OptionsPage in 'Delphi.Terminal.Plugin.OptionsPage.pas',
  Delphi.Terminal.Plugin.KeyBinding in 'Delphi.Terminal.Plugin.KeyBinding.pas',
  Delphi.Terminal.Plugin.OptionsFrame in 'Delphi.Terminal.Plugin.OptionsFrame.pas' {frameDelphiTerminalOptions},
  Delphi.Terminal.CommandHistory in '..\..\source\Delphi.Terminal.CommandHistory.pas',
  Delphi.Terminal.Frame.CmdShell in '..\..\source\Delphi.Terminal.Frame.CmdShell.pas',
  Delphi.Terminal.Settings in '..\..\source\Delphi.Terminal.Settings.pas',
  Delphi.Terminal.AnsiParser in '..\..\source\Delphi.Terminal.AnsiParser.pas',
  Delphi.Terminal.CmdShell in '..\..\source\Delphi.Terminal.CmdShell.pas',
  Delphi.Terminal.SavedCommands in '..\..\source\Delphi.Terminal.SavedCommands.pas',
  Delphi.Terminal.VariableExpander in '..\..\source\Delphi.Terminal.VariableExpander.pas',
  Delphi.Terminal.TextDecode in '..\..\source\Delphi.Terminal.TextDecode.pas',
  WinAPI.ConPty in '..\..\source\WinAPI.ConPty.pas',
  Delphi.Terminal.Pty in '..\..\source\Delphi.Terminal.Pty.pas',
  Delphi.Terminal.ConPtyReader in '..\..\source\Delphi.Terminal.ConPtyReader.pas',
  Delphi.Terminal.ConPtyShell in '..\..\source\Delphi.Terminal.ConPtyShell.pas',
  Delphi.Terminal.Plugin.SavedCommandsEditor in 'Delphi.Terminal.Plugin.SavedCommandsEditor.pas',
  Delphi.Terminal.Plugin.CommandPalette in 'Delphi.Terminal.Plugin.CommandPalette.pas';

end.
