<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{CCEE6CFD-7962-48FF-BFC3-0DCB81CEFD42}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="projects\ide-plugin\radTerminalPlugin.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="projects\demo-vcl\radTerminalDemo.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="radTerminalPlugin">
        <MSBuild Projects="projects\ide-plugin\radTerminalPlugin.dproj"/>
    </Target>
    <Target Name="radTerminalPlugin:Clean">
        <MSBuild Projects="projects\ide-plugin\radTerminalPlugin.dproj" Targets="Clean"/>
    </Target>
    <Target Name="radTerminalPlugin:Make">
        <MSBuild Projects="projects\ide-plugin\radTerminalPlugin.dproj" Targets="Make"/>
    </Target>
    <Target Name="radTerminalDemo">
        <MSBuild Projects="projects\demo-vcl\radTerminalDemo.dproj"/>
    </Target>
    <Target Name="radTerminalDemo:Clean">
        <MSBuild Projects="projects\demo-vcl\radTerminalDemo.dproj" Targets="Clean"/>
    </Target>
    <Target Name="radTerminalDemo:Make">
        <MSBuild Projects="projects\demo-vcl\radTerminalDemo.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="radTerminalPlugin;radTerminalDemo"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="radTerminalPlugin:Clean;radTerminalDemo:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="radTerminalPlugin:Make;radTerminalDemo:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
