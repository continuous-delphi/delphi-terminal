    <Target Name="ptyspike:Make">
        <MSBuild Projects="projects\spike-pty\ptyspike.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="Delphi_Terminal_VCLDemo;Delphi_Terminal_Plugin;ptyspike"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="Delphi_Terminal_VCLDemo:Clean;Delphi_Terminal_Plugin:Clean;ptyspike:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="Delphi_Terminal_VCLDemo:Make;Delphi_Terminal_Plugin:Make;ptyspike:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
